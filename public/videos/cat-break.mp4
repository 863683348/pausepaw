images-to-video","audio"],"content":{"modelType":"Multimodal reference-driven generation and editing model","topUseCases":"Brand and campaign adaptations, Product catalog and e-commerce asset updates, Social/video repurposing and reformatting, Multilingual captioning/subtitling, Creative ideation from moodboards and style guides, Compliance-safe content revisions","keyStrengths":"Best-in-class multimodal reference understanding, High-fidelity precision edits and style consistency, Scalable enterprise-ready workflows and integrations","primaryPurpose":"Create, search, and precisely edit text, image, audio, and video using rich cross-modal references to maintain consistent style and intent","bestFitScenarios":"Reference-rich pipelines requiring strict brand/style consistency, High-volume content operations needing unified cross-modal search and edit, Post-production finishing and QA, Centralized asset libraries seeking versioning and rapid localization","knownLimitations":"Output quality depends on reference quality and coverage, Long-form or high-resolution media may increase latency and cost, Human review recommended for nuanced creative decisions and regulatory compliance, Limited suitability for offline/on-device use","poorFitScenarios":"Real-time live streaming edits or ultra-low-latency needs, On-device or highly constrained compute environments, Highly specialized 3D/VFX or simulation workloads, From-scratch factual research without external data connections"}},"featurePrices":{"resolution":{"4K":8000,"480P":0,"720P":0,"1080P":2000}},"translations":{"de":{"description":"Seedance 2.0 führt zu den umfassendsten multimodalen Inhaltsreferenz- und Bearbeitungsfunktionen in der Branche"},"es":{"description":"Seedance 2.0 conduce a las capacidades de referencia y edición de contenidos multimodales más completas de la industria"},"fr":{"description":"Seedance 2.0 conduit à la référence et aux capacités d’édition de contenu multimodales les plus complètes du secteur"},"it":{"description":"Seedance 2.0 porta alla più completa capacità di riferimento e modifica dei contenuti multimodali del settore"},"nl":{"description":"Seedance 2.0 leidt tot de meest uitgebreide multimodale contentreferentie- en bewerkingsmogelijkheden in de industrie"},"pt":{"description":"Seedance 2.0 leva à referência e edição de conteúdo multimodal mais abrangentes da indústria"}}},"video":null,"presets":[]},{"id":"FT9Q9q8ppsOJ","createdAt":"2026-07-07T05:11:57.772Z","updatedAt":"2026-07-16T12:52:40.032Z","name":"Unboxing ASMR","title":"Unboxing ASMR","description":"Premium, slow-paced, purely tactile presentation with intense focus on material textures and sound cues.","icon":"sparkling","type":"marketing_ugc","videoDetailsFeatured":false,"order":10,"key":"unboxing_asmr","mode":"reference-to-video","widgetConfig":null,"promptTemplate":"# ROLE & OBJECTIVE\nYou are the dedicated backend AI generator for the \"Unboxing ASMR\" video prompt application. Your task is to generate a premium, purely tactile unboxing prompt with intense micro-movement pacing and explicit sound layer descriptions.\n\n# USER PROMPT PRIORITY\nThe user defines the product and its premium packaging materials (e.g., matte box, metallic seals).\n\n# VIDEO PROMPT FRAMEWORK\nGenerate a highly descriptive macro video prompt:\n- **Pacing:** \"Slow-paced micro-movements, zero sudden camera acceleration, steady deliberate hand motion, macro lens cuts focus entirely on material surface responses to human touch.\"\n- **Inline Sound Design:** Every physical action must be paired with an inline bracketed audio cue, exactly like this:\n  - \"Hands gently slide across the matte lid `[textured paper friction ASMR sound]`\"\n  - \"The lid is slowly lifted upward `[crisp magnetic seal release click]`\"\n  - \"Fingernails softly tap the rigid surface `[hollow rhythmic fingernail tapping sound]`\"\n\n# UNIVERSAL QUALITY CHECKLIST\n- No dialogue, voiceover, or speaker text allowed.\n- Inline sound cues written in square brackets `[...]` inline with physical actions.\n- Camera movements defined as slow macro adjustments.\n- Highly detailed surface texture descriptions (matte, metallic, embossed).\n\n# CRITICAL GENERATION RULES\n- **No Speech:** Absolutely no talking, no voiceover, no creator face in frame. Focus purely on hands, box, and product textures.\n- **Output:** Output ONLY the final video prompt inside one markdown code block. No intro/outro text.\n\n# FEW-SHOT EXAMPLE\n**User Input:** \"Unboxing of an expensive perfume, black matte box, gold bottle.\"\n**Expected Output:**\nPremium ASMR unboxing video look, vertical 9:16, static top-down macro lens framing, clean white desk surface, soft diffused studio light. No creator face. Slow-paced micro-movements, zero camera acceleration. 0–5s: Two manicured hands enter the lower frame. Finger pads slowly slide across a rigid black matte gift box lid `[textured paper friction ASMR sound]`. Fingernails softly tap the top surface three times `[hollow rhythmic fingernail tapping sound]`. 5–10s: The hands slowly lift the top lid vertically in one clean motion `[crisp magnetic seal release click]`, revealing a shiny gold metallic perfume bottle nestled in black velvet. 10-15s: Hands slowly lift the gold bottle, rotating it to catch the light. Macro focus on structural bottle seams.","videoId":null,"modelId":"F2sQv0Me84HZ","model":{"id":"F2sQv0Me84HZ","createdAt":"2026-04-10T13:00:31.405Z","updatedAt":"2026-07-23T14:55:48.019Z","key":"seedance-2-0","slug":"seedance-2-0","name":"Seedance 2.0","logo":"byteDance","type":"video","order":1,"toolId":"7yaoOMo1Aj","description":"Seedance 2.0 leading to the most comprehensive multimodal content reference and editing capabilities in the industry","freeGenerations":0,"maxPromptLength":5000,"pricePerUnit":2000,"minimumUnits":4,"unitLabelSingular":"video","unitLabelPlural":"videos","generationTime":300,"isActive":true,"isNew":null,"isPremium":true,"isFeatured":true,"hasGenerator":true,"tot