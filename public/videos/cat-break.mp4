arge":"Image width is too large","image_width_too_small":"Image width is too small","video_width_too_large":"Video width is too large","video_width_too_small":"Video width is too small","image_height_too_large":"Image height is too large","image_height_too_small":"Image height is too small","invalid_file_extension":"Invalid file extension","video_height_too_large":"Video height is too large","video_height_too_small":"Video height is too small","email_taken_description":"Please use a different email address or log in","video_duration_too_long":"Video duration is too long","video_duration_too_short":"Video duration is too short"},"video_page":{"free":"This video is free, and no attribution is required (although always appreciated). To access this video at its highest quality, consider joining Coverr Plus for exclusive benefits.","meta":{"title":"{{ title }} - Free Stock Video Footage | Coverr","description":"Download royalty free (for personal and commercial use), {{ title }} video footage for your website or any project. No attribution required."},"no_attr":"All Coverr videos are 100% free — no catch. Attribution never required, always appreciated.","premium":"This video is premium, available exclusively for Coverr Plus members. Join today to enjoy this high-quality content along with other exclusive benefits and an ad-free experience.","ai_badge":"AI Generated","view_workflow":"View AI Workflow"},"ai_textarea":{"prompt_required":"Prompt is required","prompt_placeholder":"Describe your idea"},"entity_form":{"add":"Add {{ name }}","errors":{"field_pattern":"Value must be a valid {{ name }}","field_required":"{{ name }} is required"},"images_uploader":{"select_files":"Select files"}},"getty_image":{"see_more":"See more","open_istock_image":"Open image from iStock"},"plus_banner":{"title":"The all-in-one subscription for creators:"},"seo_section":{"p1":"In a world where video is king, our collection of 100% free stock videos is your secret weapon for captivating audiences. From the tranquil beauty of nature to the pulsating energy of cityscapes, our videos enhance any project.","p2":"Perfect for seamless b-roll, background settings for music videos, or elevating social media posts, our handpicked footage offers endless inspiration. Available for personal and commercial use with no attribution needed, our videos are ideal for your next creative endeavor. Elevate your projects with a few clicks – explore, select, and transform your vision into reality.","titleHTML":"Unleash Creativity with Our Free Stock Video Library"},"music_banner":{"cta":"Check it out","title":"Try coverr music","description":"Never worry about rights and royalty"},"search_input":{"recents":"Recents","empty_state":"Start typing to see suggestions...","placeholder":{"image":"Search for an image","music":"Search for a music","video":"Search for a video","ai_sfx":"Describe SFX idea","ai_image":"Describe image idea","ai_music":"Describe music idea","ai_video":"Describe video idea","ai_voiceover":"Write voiceover text"},"recent_searches":"Recent searches","generate_ai_video":"Generate AI Video","promoted_pb_searches":"Trending on Premium Beat","promoted_getty_searches":"Trending on iStock"},"search_music":{"meta":{"title":"Download {{ total }} Free {{ query }} Stock Music | Coverr","description":"Explore our collection of royalty-free {{ query }} music. Perfect for videos and projects, find and download high-quality stock music tracks on Coverr."},"no_results_found":"No results found for"},"shutterstock":{"open_premium_beat":"Open premium beat"},"video_scenes":{"share":"Share Scene","view_all":"View all scenes","load_more":"Load more scenes","grid_title":"Free Stock Video Scenes Footage","videos_grid_title":"More videos in scene"},"ai_model_card":{"audio":"Audio","start":"Start","start_end":"Start / End"},"ai_video_card":{"mute":"Mute","unmute":"Unmute","cta_copy":"Try now"},"category_page":{"explore_related_tags":"Explore related tags"},"checkout_page":{"meta":{"tit