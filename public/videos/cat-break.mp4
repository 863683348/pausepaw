g":"Unboxing","username":"Username","view_all":"View all","advertise":"Advertise","ai_models":"AI Models","ai_studio":"AI Studio","by_artist":"By {{artist}}","by_author":"By {{ author }}","claim_now":"Claim Now","clear_all":"Clear all","colorr_ai":"Color Palette Generator","community":"Community","copy_link":"Copy link","downloads":"Downloads","home_page":"Home page","last_name":"Last name","my_videos":"My videos","next_page":"Next page","open_menu":"Open menu","pinterest":"Pinterest","prev_page":"Previous page","relevance":"Relevance","show_less":"Show less","show_more":"Show more","subscribe":"Subscribe","view_more":"View More","voiceover":"Voiceover","workflows":"Workflows","all_models":"All Models","categories":"Categories","commercial":"Commercial","contact_us":"Contact Us","contribute":"Contribute","first_name":"First name","free_stock":"Free Stock","free_video":"Free video","get_coverr":"Get Coverr+","learn_more":"Learn more","my_profile":"My Profile","my_uploads":"My Uploads","next_video":"Next video","open_getty":"Open Getty","prev_video":"Previous video","redeem_now":"Redeem Now","resolution":"Resolution","smart_crop":"Smart crop","try_prompt":"Try Prompt","upload_all":"Upload All","variations":"Variations","your_email":"Your email","ai_workflow":"AI Workflow","change_file":"Change file","collections":"Collections","coming_soon":"Coming soon","copy_prompt":"Copy Prompt","coverr_free":"Coverr Free","coverr_plus":"Coverr Plus","enter_email":"Enter your email","get_credits":"Get Credits","get_started":"Get Started","search_dots":"Search...","see_details":"See details","select_file":"Select File","toggle_item":"Toggle item","upgrade_now":"Upgrade Now","ai_generated":"AI Generated","ai_voiceover":"AI Voiceover","ai_workflows":"AI Workflows","apply_coupon":"Apply Coupon","aspect_ratio":"Aspect ratio","back_to_home":"Back to home","before_after":"Before & After","category_alt":"Free {{ name }} Stock Video Footage and Clips","join_discord":"Join Coverr on Discord"