notified","subscribe_title":"Subscribe to get updates about Coverr Music","download_started":"Download started!","attribution_text_HTML":"Audio downloaded on \u003Ca href=\"https://coverr.co/\" target=\"_blank\" class=\"acu-link\">Coverr\u003C/a>","attribution_text_markdown":"Audio downloaded on [Coverr](https://coverr.co)"},"premium_video_block":{"title":"Unlock this premium video and also get:","features":["AI video generator","AI voiceover generator","4K footage & WAV music","Exclusive content added weekly","Ad-free experience"]},"user_ai_generations":{"meta":{"title":"AI Video Generations | Coverr","description":"Your Video Generations"},"title":"Create stunning videos","toast":{"title":"Workflows are being reviewed","description":"We are reviewing your workflows, once they are approved you will be able to upload more."},"header":"Your Video Generations","description":"Join the future of video creation. Unlock the potential of AI-powered prompts, seamless workflows, and stunning results with PromptLab.","submit_button":"Generate New AI Video"},"get_more_free_videos":{"title":"Get more videos","email_us":"Email Us for More Videos","description":"This video limit is temporary for the beta version. Want more videos? Just email us at","request_more":"Request More Videos","share_feedback":"Share Feedback with Our Team"},"notifications_widget":{"ideas_title":"Coverr Ideas","newsfeed_title":"What’s new on Coverr","suggest_feature":"Suggest feature","success_vote_toast":"You’ve successfully voted for this idea!","success_unvote_toast":"You’ve successfully removed your vote.","signup_vote_description":"Sign up to vote for ideas","signup_suggest_description":"Sign up to suggest your own idea"},"workflow_upload_modal":{"form":{"title":"Describe your workflow"},"title":"Upload videos you generated with AI","select":{"title":"Upload your AI-generated video","guidelines":{"guideline_0":{"title":"Workflow Sharing","description":"Don’t upload if you’re not planning to share the