o","imageToVideoEndpointSlug":"https://queue.fal.run/bytedance/seedance-2.0/reference-to-video","videoToVideoEndpointSlug":null},"costModifiersUsd":{"resolution":{"4K":1.255,"480P":0,"720P":0,"1080P":0.382}}}],"features":{"list":["text-to-video","start-end-frames-to-video","reference-images-to-video","audio"],"content":{"modelType":"Multimodal reference-driven generation and editing model","topUseCases":"Brand and campaign adaptations, Product catalog and e-commerce asset updates, Social/video repurposing and reformatting, Multilingual captioning/subtitling, Creative ideation from moodboards and style guides, Compliance-safe content revisions","keyStrengths":"Best-in-class multimodal reference understanding, High-fidelity precision edits and style consistency, Scalable enterprise-ready workflows and integrations","primaryPurpose":"Create, search, and precisely edit text, image, audio, and video using rich cross-modal references to maintain consistent style and intent","bestFitScenarios":"Reference-rich pipelines requiring strict brand/style consistency, High-volume content operations needing unified cross-modal search and edit, Post-production finishing and QA, Centralized asset libraries seeking versioning and rapid localization","knownLimitations":"Output quality depends on reference quality and coverage, Long-form or high-resolution media may increase latency and cost, Human review recommended for nuanced creative decisions and regulatory compliance, Limited suitability for offline/on-device use","poorFitScenarios":"Real-time live streaming edits or ultra-low-latency needs, On-device or highly constrained compute environments, Highly specialized 3D/VFX or simulation workloads, From-scratch factual research without external data connections"}},"featurePrices":{"resolution":{"4K":8000,"480P":0,"720P":0,"1080P":2000}},"translations":{"de":{"description":"Seedance 2.0 führt zu den umfassendsten multimodalen Inhaltsreferenz- und Bearbeitungsfunktionen in der Branche"},"es":{"description":"Seedance 2.0 conduce a las capacidades de referencia y edición de contenidos multimodales más completas de la industria"},"fr":{"description":"Seedance 2.0 conduit à la référence et aux capacités d’édition de contenu multimodales les plus complètes du secteur"},"it":{"description":"Seedance 2.0 porta alla più completa capacità di riferimento e modifica dei contenuti multimodali del settore"},"nl":{"description":"Seedance 2.0 leidt tot de meest uitgebreide multimodale contentreferentie- en bewerkingsmogelijkheden in de industrie"},"pt":{"description":"Seedance 2.0 leva à referência e edição de conteúdo multimodal mais abrangentes da indústria"}}},"video":null,"presets":[]},{"id":"1VjYBFMD6i0M","createdAt":"2026-07-07T05:13:20.691Z","updatedAt":"2026-07-16T12:52:40.063Z","name":"Camera POV","title":"Camera POV","description":"Strict first-person perspective tracking, showcasing what the character actually sees.","icon":"sparkling","type":"marketing_tik_tok","videoDetailsFeatured":false,"order":20,"key":"camera_pov","mode":"reference-to-video","widgetConfig":null,"promptTemplate":"# ROLE & OBJECTIVE\nYou are the dedicated backend AI generator for the \"Camera POV\" video prompt application. Your task is to generate a strict first-person perspective video prompt where the camera represents the user's literal eyeballs.\n\n# USER PROMPT PRIORITY\nThe user defines what product is being interacted with and where the character is walking or looking.\n\n# VIDEO PROMPT FRAMEWORK\nGenerate a strict POV prompt using these physical rules:\n- **Zero Face Clause:** You must NEVER describe or generate the face, head, or full body of the main character. \n- **Frame Composition:** Only the left and right hands of the character enter the frame from the bottom left and bottom right corners of the screen to interact with the environment or product.\n- **Kinetics:** Explicitly describe the motion using physics: \"subtle vertical walking head-bob kinetics, realistic panning shifts when looking left to right, natural arm extension shadows cast onto the surface ahead\".\n\n# UNIVERSAL QUALITY CHECKLIST\n- Absolute exclusion of the main actor's face/body features from the prompt text.\n- Hands entering from lower corners must be explicitly positioned.\n- Motion physics terms included (head-bob, panning shifts).\n\n# CRITICAL GENERATION RULES\n- **Camera Specs:** \"True 1st person POV camera angle, wide-angle lens field of view, natural hand coordination in lower third of frame\".\n- **Output:** Output ONLY the final video prompt inside one markdown code block. No intro/outro text.\n\n# FEW-SHOT EXAMPLE\n**User Input:** \"A person walks through a supermarket, reaches out, and grabs a jar of protein from the shelf.\"\n**Expected Output:**\nTrue 1st person POV camera angle, wide-angle lens field of view, vertical 9:16 aspect ratio. The lens represents the direct eyes of the character. No face or body is visible. Subtle vertical walking head-bob kinetics as the camera moves down a bright supermarket aisle with tall shelves. Bright overhead fluorescent store lighting. The camera pans smoothly to the right toward a shelf. A single realistic male right hand enters from the bottom right corner of the frame, reaches out, and grips a tall cylindrical white protein jar with a clean blue label. Macro texture on the plastic grip as the hand lifts the jar off the shelf and pulls it into the lower center of the frame.","videoId":null,"modelId":"F2sQv0Me84HZ","model":{"id":"F2sQv0Me84HZ","createdAt":"2026-04-10T13:00:31.405Z","updatedAt":"2026-07-23T14:55:48.019Z","key":"seedance-2-0","slug":"seedance-2-0","name":"Seedance 2.0","logo":"byteDance","type":"video","order":1,"toolId":"7yaoOMo1Aj","description":"Seedance 2.0 leading to the most comprehensive multimodal content reference and editing capabilities in the industry","freeGenerations":0,"maxPromptLength":5000,"pricePerUnit":2000,"minimumUnits":4,"unitLabelSingular":"video","unitLabelPlural":