{"title":"The 7-day free trial provides the capability to generate two (2) Google Veo videos and ten (10) AI images."},"free_trial_success_toast":{"title":"You’re all set! Your free trial has started — you haven’t been charged. You’ll be billed in 7 days when the trial ends.We’ve sent you an email with the details of your upcoming payment."}}},"download":{"full_hd":"Full HD","original":"Original","full_hd_preview":"Full HD Preview"},"advertise":{"meta":{"title":"Advertise on Coverr","description":"Reach millions of developers, designers and entrepreneurs with various advertising opportunities on Coverr, the leading free stock footage website. | Coverr"},"title":"Advertise with us","lets_talk":"Let’s talk","section_1":{"title":"Interested in promoting your brand? Having millions of people view and share videos showcasing your product?","description":"We enable businesses to create premium videos that will be available for download free on Coverr’s site."},"section_2":{"title":"A Collection of your branded videos","description":"We will create a custom collection of at least 5 branded videos with your product in it. Our creative team will work with you on the concept and choose the right filmmaker to shoot it. All videos will be 100% fully downloadable by our users and live forever on the web. Your collection will also have a custom landing page with a link to your website or product."},"section_3":{"title":"Anthem video","description":"Our homepage is the gate to our video kingdom. The most traffic, eyeballs, time spent, you name it. Your video will live on our homepage for 7 days."},"section_4":{"title":"One of a kind","description":"You can send us your branded video (must follow our guideline) and we will place it on our homepage, first row below our collections."},"newsletter":{"title":"Newsletter","section":{"title":"Access unlimited free video content","description":"We are so exicted to have you onboard! Our mission is to provide free video content to all of our subscribers. Here is what you can do to always have the latest video content for all ocassions."},"description":"Our newsletter is a direct path to your audience on Coverr. With tens of thousands of eyeballs receiving it monthly and high open rate, this is the best way to measure direct engagement"},"description":"Bring your business to the masses with branded videos that will be shared by millions."},"ai_portal":{"sfx":{"empty":{"title":"Generate your first sound effect","description":"Your AI-generated sound effects will appear here once they’re ready"},"title":"SFX generator","toasts":{"duration_long_title":"Duration is too long","text_required_title":"Text is required","duration_short_title":"Duration is too short","text_required_subtitle":"Please enter a text to generate.","duration_required_title":"Duration is required","created_successfully_title":"Sound effect created successfully","duration_required_subtitle":"Please enter a duration to generate.","duration_long_subtitle_param":"Your duration is too long. Please keep it under {{ maxSeconds }} seconds.","duration_short_subtitle_param":"Your duration is too short. It must be at least {{ minSeconds }} seconds."},"text_label":"Describe the sound you need","description":"Instantly create realistic sound effects with AI. Perfect for videos, games, and podcasts.","duration_label":"Audio duration","examples_label":"Use examples to get started:","text_placeholder":"Rain with thunder...","credit_rate_param":"1 second costs {{ credits }} credits","duration_hint_param":"Generation duration between {{ min }} and {{ max }} seconds","credit_rate_param_default":"1 generation costs {{ credits }} credits"},"apps":{"title":"AI Apps","description":"Use the AI Apps to generate videos, images, and more","subtitles_preview":{"title":"Preview Area","description":"Upload a video to see how your subtitles will look"}},"home":{"whats_new":{"title":"What's new","description":"The latest features, models, and updates — fresh off the press"},"search_section":{"good_night":"Good Night. Great visuals start here.","good_evening":"Good Evening. Great visuals start here.","good_morning":"Good Morning. Great visuals start here.","good_afternoon":"Good Afternoon. Great visuals start here."},"featured_models":{"title":"Featured AI models","description":"Explore our curated selection of powerful AI models"},"inspiration_section":{"title":"Get Inspired","description":"Discover high-quality videos — for creators"}},"audios":{"empty":{"title":"Generate your first audio track","description":"Your AI-generated audio tracks will appear here once they’re ready"},"title":"AI Music generator","toasts":{"prompt_long_title":"Prompt is too long","prompt_short_title":"Prompt is too short","prompt_required_title":"Prompt is required","prompt_required_subtitle":"Please enter a prompt to generate.","created_successfully_title":"Audio created successfully","prompt_long_subtitle_param":"Your prompt is too long. Please keep it under {{ count }} characters.","prompt_short_subtitle_param":"Your prompt is too short. It must be at least {{ count }} characters long."},"description":"Generate audio tracks instantly with AI","minutes_param":"{{ count }} minutes","seconds_param":"{{ count }} seconds","examples_label":"Use examples to get started:","credit_rate_param":"1 audio track costs {{ credits }} credits","from_credits_param":"{{ count }}+ credits","prompt_placeholder":"Describe the vibe, instruments, genre, and mood for your music","signup_description":"Sign up to generate audios for free","sample_count_label_param":"{{ count }} audio","samples_count_label_param":"{{ count }} audios"},"images":{"empty":{"title":"Generate your first image","description":"Your AI-generated images will appear here once they’re ready"},"title":"AI Image Generator","toasts":{"prompt_long_title":"Prompt is too long","prompt_short_title":"Prompt is too short","image_required_title":"Image is required","prompt_required_title":"Prompt is required","image_required_subtitle":"Please upload an image to generate.","prompt_required_subtitle":"Please enter a prompt to generate.","created_successfully_title":"Images created successfully","prompt_long_subtitle_param":"Your prompt is too long. Please keep it under {{ maxLength }} characters.","prompt_short_subtitle_param":"Your prompt is too short. It must be at least {{ minLength }} characters long."},"enhancer":{"title":"AI prompt enhancer","subtitle":"AI will refine your prompt for better results"},"description":"Generate images instantly with AI","credit_rate_param":"1 image costs {{ credits }} credits","prompt_placeholder":"Describe image here","ai_models_description":{"imagen_3":"Google’s highest quality text-to-image model","imagen_4":"Google’s next-generation text-to-image model with even higher visual fidelity","imagen_3_fast":"A faster and cheaper Imagen 3 model","imagen_4_fast":"A faster, cost-effective version of Imagen 4 for quick high-quality results"},"sample_count_label_param":"{{ count }} image","samples_count_label_param":"{{ count }} images"},"shared":{"tips":["All prompts should be direct and easily understood, not conceptual","Prompts should be descriptive, not conversational or command-based","Prompts should use positive phrasing"],"how_it_works":"How it works","minute_param":"{{ count }} minute","second_param":"{{ count }} second","view_pricing":"View pricing","minutes_param":"{{ count }} minutes","seconds_param":"{{ count }} seconds","enhance_prompt":"Enhance prompt","my_generations":"My generations","rate_limit_title":"Parallel generation limit reached","credits_available":"Credits available: {{ count }}","toast_description":"You can always buy more","used_free_credits":"You’ve used all your free credits. Upgrade to keep creating.","from_credits_param":"{{ count }}+ credits","signup_description":"Sign up to generate for free","generations_available":"Generations available: {{ count }}","all_models_description":"Pick any from {{ count }} available","free_generations_param":"{{ model }} free generations: {{ count }} left","rate_limit_description":"You’ve reached your parallel generation limit. Wait for current generations to finish or upgrade to continue without waiting","support_only_one_option":"This model supports only a single option"},"videos":{"title":"AI Video Generator","styles":"Styles","effects":"Effects","description":"Use the Image to Video or Text to Video AI generator","inspiration":"Inspiration","explore_more":"Explore more","recreate_tour":{"done_cta":"Let’s recreate!","textarea":{"title":"Add your details","description":"Describe how you’d like to reimagine your video — lighting, camera movement, or visual style. Then hit Generate to bring it to life."},"media_uploader":{"title":"Select a Video","description":"Choose a video from our stock library that you’d like to reimagine."},"app_prefference":{"title":"Select an App","description":"Choose what you want to do — for example New camera angles or Generate next shot."},"preset_prefference":{"title":"Select a Preset","description":"Pick a visual style to define your recreated video."},"mode_segment_controls":{"title":"Recreate is here","description":"Transform your existing videos — change camera angles, style, or even generate the next shot to continue your story."}},"generation_rate":"Generation cost: {{ cost }} credits","how_it_works_page":{"steps":{"generate":{"title":"Generate Video","description":"Click generate and watch AI create your video in minutes"},"configure":{"title":"Configure Settings","description":"Adjust duration, aspect ratio, resolution, and other parameters to customize your video"},"edit_video":{"title":"Upload Video to Edit","description":"Upload your video and let AI transform it with the selected style"},"upload_image":{"title":"Upload Image","description":"Upload an image as the starting frame for your animation"},"motion_control":{"title":"Add Character and Motion","description":"Upload a character image and a motion reference video to guide the AI"},"reference_video":{"title":"Provide Reference Video","description":"Upload a reference video to guide the motion and style of your result"},"start_end_frames":{"title":"Set Start & End Frames","description":"Upload the first and last frames to define your video’s transformation"},"references_images":{"title":"Add Reference Images","description":"Provide reference images to guide the video style and composition"}},"title":"Create AI Videos in Simple Steps","description":"Follow these steps to bring your ideas to life with our AI video generator."},"prompt_preferences":{"generate_audio":{"title":"Generate audio","description":"Veo 3 lets you add sound effects, ambient noise, and even dialogue to your creations"},"publish_consent":{"title":"Public Visibility","video_description":"When enabled, your video may be reviewed and featured by our editorial team on Coverr","images_description":"When enabled, your images may be reviewed and featured by our editorial team on Coverr"}},"signup_description":"Sign up to generate videos for free","ai_models_description":{"veo2":"Ultra-realistic and high-quality videos","veo3":"The most advanced AI video generation model in the world. With sound on!","ray_2":"Enhanced quality and motion consistency","kling_2":"Next-gen realism with dynamic scene understanding","ray_1_6":"Smooth cinematic video generation","gen4Turbo":"Fast, controllable and flexible video generation","kling_1_6":"Creative and expressive video synthesis","kling_2_1":"Unparalleled motion fluidity, cinematic visuals, and exceptional prompt precision","veo3_fast":"Speed meets creativity — create high-quality videos with sound in record time.","gen3aTurbo":"Fast and versatile AI video creation","seedance_1":"High-quality videos with cinematic motion, storytelling, and pro-grade effects"},"auto_model_description":"We’ll pick the best model for your prompt"},"ai_voices":{"empty":{"title":"No voices match your filters","description":"Try