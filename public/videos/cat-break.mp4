d ten (10) AI images."},"plus_page":{"videos":{"title":"Featured premium videos"},"subscribe":{"save":"Save ${{ count }}","titleHTML":"Premium videos, \u003Cspan class=\"color-new-primary-main\">unlimited access,\u003C/span> and more.","billed_yearly":"per month,\nbilled yearly","billed_monthly":"per month,\nbilled monthly"},"collections":{"enjoyHTML":"Enjoy our \u003Cspan class=\"color-new-primary-main\">members-only content,\u003C/span> curated just for you","section_title":"Curated collections"},"trusted_creators":{"text":"Trusted by 1,000+ creators building with AI every day","text_compact":"Trusted by 1,000+ creators"}},"tool_page":{"hero":{"suggestions":[{"label":"Sunny Beach","prompt":"A peaceful sunny beach with waves gently crashing on the shore."},{"label":"City Night","prompt":"A busy city street at night with neon signs and passing cars."},{"label":"Mountain Hike","prompt":"A person hiking through a forest trail with mountains in the background."},{"label":"Rainy Window","prompt":"Raindrops falling on a window with a blurry view of the city outside."},{"label":"Desert Sunset","prompt":"A sunset over sand dunes with warm orange and pink colors."},{"label":"Forest Fog","prompt":"A dense forest covered in morning fog with light filtering through trees."}],"view_website":"View Website","submit_prompt":"Submit {{ toolName }} prompt","generate_in_studio":"Generate in Studio"},"explore":{"title":"Explore More AI Video Models"},"videos_grid":{"title_param":"Explore {{ toolName }} videos"}},"contact_us":{"form":{"name":"Your name","email":"Email address","error":"Something went wrong. Please try again","submit":"Send message","message":"Message","subject":"Subject","error_email":"Please enter a valid email address","success_desc":"We’ll get back to you as soon as possible","success_title":"Message sent!","error_required":"This field is required"},"link":"Contact Us","meta":{"title":"Contact Us | Coverr — Support for Creators","description":"Reach out to the Coverr team for support, licensing inquiries, or feedback. We’re here to help you find the perfect cinematic footage"},"title":"Get in Touch","overlay":{"title":"Create with us","description":"Join a community of world-class creators"},"description":"Have a question or feedback? We’d love to hear from you"},"contribute":{"meta":{"title":"Contribute Free Stock Footage And Get Paid | Coverr","description":"The only free stock footage website that pays to its contributors | Coverr"},"title":"Contribute free videos/music, get paid.","apply_now":"Apply now","section_1":{"title":"We support our community","description":"While we give all our videos away for free, we believe in paying the talented creators behind them. Coverr videos are carefully curated and creators are paid for their submissions. The more we grow, the more contributors we’re able to support."},"section_2":{"title":"We have a wide reach","description":"Coverr videos are seen and shared by hundreds of thousands of users. You can see your work cropping up everywhere from inspirational music videos to the next best app."},"section_3":{"title":"We believe in accessibility","description":"We started Coverr as a way to give access to those who can’t afford to commission or buy video footage. You’ll be empowering countless startups, dreamers, and believers on their missions to make something."},"description":"Share your talent with the Coverr community, get paid for your work, and watch millions of users showcase your videos across the globe.","apply_section":{"apply":"Apply to Contribute","title":"Did we mention you’ll get paid?","description":"Just want to make sure you saw that."},"sections_title":"Why contribute to Coverr?"},"intentions":[{"label":"To create organic online content","value":"To create organic online content"},{"label":"For commercial projects (online or TV ads.)","value":"For commercial projects (online or TV ads.)"},{"label":"For educational purposes","value":"For educational purposes"},{"label":