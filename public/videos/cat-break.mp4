e","best_value":"Best Value","most_popular":"Most Popular","cancel_anytime":"Cancel anytime — no hidden fees","free_trial_toast":"The free trial provides the capability to generate two (2) Google Veo videos and ten (10) AI images."},"plus_page":{"videos":{"title":"Featured premium videos"},"subscribe":{"save":"Save ${{ count }}","titleHTML":"Premium videos, \u003Cspan class=\"color-new-primary-main\">unlimited access,\u003C/span> and more.","billed_yearly":"per month,\nbilled yearly","billed_monthly":"per month,\nbilled monthly"},"collections":{"enjoyHTML":"Enjoy our \u003Cspan class=\"color-new-primary-main\">members-only content,\u003C/span> curated just for you","section_title":"Curated collections"},"trusted_creators":{"text":"Trusted by 1,000+ creators building with AI every day","text_compact":"Trusted by 1,000+ creators"}},"tool_page":{"hero":{"suggestions":[{"label":"Sunny Beach","prompt":"A peaceful sunny beach with waves gently crashing on the shore."},{"label":"City Night","prompt":"A busy city street at night with neon signs and passing cars."},{"label":"Mountain Hike","prompt":"A person hiking through a forest trail with mountains in the background."},{"label":"Rainy Window","prompt":"Raindrops falling on a window with a blurry view of the city outside."},{"label":"Desert Sunset","prompt":"A sunset over sand dunes with warm orange and pink colors."},{"label":"Forest Fog","prompt":"A dense forest covered in morning fog with light filtering through trees."}],"view_website":"View Website","submit_prompt":"Submit {{ toolName }} prompt","generate_in_studio":"Generate in Studio"},"explore":{"title":"Explore More AI Video Models"},"videos_grid":{"title_param":"Explore {{ toolName }} videos"}},"contact_us":{"form":{"name":"Your name","email":"Email address","error":"Something went wrong. Please try again","submit":"Send message","message":"Message","subject":"Subject","error_email":"Please enter a valid email address","success_desc":"We’ll get back to you as so