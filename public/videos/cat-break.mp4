description":"Something went wrong. Please try again."}},"api_integrations":{"id":"ID","demo":"Demo","meta":{"title":"API Applications | Coverr","description":"API Applications"},"errors":{"error_create":"Ooops, error happened while creating an application. Please try again.","error_delete":"Ooops, error happened while deleting an application. Please try again.","error_update":"Ooops, error happened while updating an application. Please try again.","error_verify":"Ooops, error happened while requesting application verification. Please try again.","error_publish":"Ooops, error happened while publishing an application. Please try again.","name_required":"Name field is required","field_required":"Field is required","description_required":"Description field is required","error_create_limit_title":"Application limit reached","error_publish_limit_title":"You have reached the maximum number of published applications","error_create_limit_description":"You can create a maximum of {{count}} apps.","error_publish_limit_description":"If you want to have more than 1 application, please contact us at \u003Ca href=\"mailto:team@coverr.co\" class=\"acu-link\">team@coverr.co\u003C/a>."},"status":"Status","api_key":"API Key","app_name":"App name","in_review":"In Review","delete_yes":"Yes, I would like to delete.","enterprise":"Enterprise","name_title":"What’s the name of your app?","production":"Production","delete_body":"The deletion is permanent. Once an application is deleted, it cannot be recovered.","applications":"Applications","delete_title":"Are you sure you want to delete the application?","status_details":"Status details","name_placeholder":"Name","description_title":"Please provide a description of your app","update_application":"Update application","pending_status_info":"Your app is under review.","verified_status_info":"Production status gives you \u003Cstrong>2,000 requests per hour.\u003C/strong>","do_you_have_questions":"Do you have any question? Check out our \u003Ca href=\"https://api.coverr.co/docs\" aria-label=\"Documentation\" class=\"acu-link\" target=\"_blank\">Documentation\u003C/a> or \u003Ca href=\"mailto:team@coverr.co\" target=\"_blank\" class=\"acu-link\">Contact Us\u003C/a>.","create_new_application":"Create new application","enterprise_status_info":"Need more requests? Contact us at \u003Ca href=\"mailto:team@coverr.co\" target=\"_blank\" class=\"acu-link\">team@coverr.co\u003C/a>.","no_applications_header":"Thanks for your interest in using our API!","unverified_status_info":"Demo status gives you \u003Cstrong>50 requests per hour.\u003C/strong>","verification_questions":{"will_you_pay":"Are you open to paying for using our API?","whats_your_role":"What’s your role?","whats_your_site":"Please provide the URL of your site","how_much_will_pay":"How much are you willing to pay for using our API?","will_you_pay_options":["Yes","No"],"how_soon_to_implement":"How soon are you planning to implement the API?","whats_your_company_name":"What’s the name of your company?","will_you_pay_yes_answer":"Yes","how_much_will_pay_options":["$10 - $50 per month","$50-$200  per month","$200 - $500 per month","I’m flexible"],"how_soon_to_implement_options":["ASAP","1-3 months","4-6 months","6+ months"]},"description_placeholder":"Description","request_app_verification":"Request app verification","no_applications_description":"Create an application to start using our API."},"collections_page":{"meta":{"title":"Collections | Coverr","description":"Explore curated collections handpicked by our staff"},"title":"Collections","one_item":"item","description":"Explore curated collections handpicked by our staff","plural_of_items":"items"},"contribute_modal":{"title":"Contribute to Coverr","toasts":{"video_submitted":{"title":"Video Submitted! Thank You!","description":"We’ll review your video and publish it on our website."}},"license":"All published videos are licensed under the \u003Ca href=\"https://coverr.co/license/\" target=\"_blank\" class=\"acu-link\">Coverr license\u003C/a> and are free to use. Videos will appear in both the video library and AI workflows.","subtitle":"Thank you for helping us make content accessible to everyone!","features_list":{"title":"What you’ll get:","features":["Become a verified contributor","Receive the attention of our audience","Credit as the author of your content","Personalized author page on our platform"]}},"download_history":{"meta":{"title":"Download History | Coverr","description":"Download History"}},"free_stock_music":{"faq":[{"answer":"\u003Cp>Royalty-free music is a type of music licensing that allows individuals and businesses to use music without having to pay ongoing royalties or fees for each use.\u003C/p>\u003Cp class=\"mt-3\">Coverr offer you to download free stock music with no tricks and extra fees.\u003C/p>","question":"What is royalty-free music?"},{"answer":"We’re now in the hunt for the best composers out there, we’re paying for all the free music we’re going to offer so if you’re interested, please apply \u003Ca href=\"/developers\" aria-label=\"Developers page\" class=\"acu-link\">here\u003C/a>.","question":"I’m a musician/composer, how can I get involved?"},{"answer":"Since WAV format is the highest quality, and quality is what we believe in, you’ll get our free songs in: WAV 16 bit, 44.1 kHz MP3 320 kbit/s","question":"What is the quality of the songs available to download?"},{"answer":"\u003Cp>Coverr Free Music is ideal to be used as free background music for all types of videos. Other popular use cases where you can use our free music tracks include:\u003C/p>\u003Cul>\u003Cli>YouTube\u003C/li>\u003Cli>Blogs\u003C/li>\u003Cli>Music Videos\u003C/li>\u003Cli>Websites\u003C/li>\u003Cli>Social Media platforms\u003C/li>\u003Cli>Podcasts\u003C/li>\u003Cli>Online ads\u003C/li>\u003Cli>Video Games\u003C/li>\u003C/ul>","question":"Where can I use Coverr’s Free Stock Music?"},{"answer":"Yes, it’s fine to use our stock music tracks and videos on YouTube.","question":"Can I use Coverr Free Music on YouTube?"},{"answer":"That’s because we have an affiliate partnership in which we show our users additional options in case we weren’t able to satisfy our users’ needs.","question":"Why am I seeing music tracks from ShutterStock/PremiumBeat?"},{"answer":"Attribution is appreciated but not required. We’d love to see what you create using our free music and videos, so feel free to mention @coverrco and/or link to coverr.co if you feel like it.","question":"Am I supposed to attribute Coverr if I’m using your free stock music?"},{"answer":"Wow, we love great ideas! Please \u003Ca href=\"/contact-us\" class=\"acu-link\">contact us\u003C/a>.","question":"What if I have a great idea for you guys?"}],"mood":"Mood","genres":"Genres","breadcrumb":"Free Stock Music","top_tracks":"Top tracks","instruments":"Instruments","popular_tags":{"synth":"synth","dreamy":"dreamy","ambient":"ambient","cinematic":"cinematic","electronic":"electronic"}},"get_more_credits":{"title":"Get more AI credits","toast":{"title":"Need more?","description":"Contact us to get more credits"},"description":"Buy more credits and explore your creativity","pricing_toast":{"cta":"View pricing","title":"How much can I generate?","description":"Check detailed plans and costs on our Pricing page"},"pricing_details":{"li_1":"Ai Voice Over - 1 character = 1 credit (1 minute script = ~625 credits)","li_2":"Ai Video - 1 video = 5K credits","li_3":"Ai Sound Effect - 1 sound effect = 200 credits","title":"Pricing details"}},"highlight_banner":{"text":"\u003Cp class=\"highlight-banner__text text-xl\">The \u003Cspan class=\"highlight-banner__gradient-text\">most advanced\u003C/span> AI Video model is now on \u003Cspan class=\"highlight-banner__gradient-text\">Coverr+\u003C/span>\u003C/p>","button_text":"Generate videos with Veo 2","default_alt":"Thumbnail of an AI-generated video created using Google Veo 2"},"marketing_studio":{"grid_title":"Get Inspired","video_titles":