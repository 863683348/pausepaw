es_title_param":"Free {{ name }} Stock Images","title_more_partners":"More from Our Partners","title_related_param":"Related {{ name }} Stock Videos","title_more_free_param":"More Free {{ name }} Stock Videos","title_related_free_param":"Related Free {{ name }} Stock Videos"},"home":{"faq":{"questions":[{"answer":"Yes! Coverr video is a completely free stock footage website that allows you to download and use high-quality stock videos anywhere. And there is no catch! No sign-up needed, no attribution required or hidden tricks anywhere, when we say free, we mean it.","question":"Are all Coverr videos completely free? What’s the catch?"},{"answer":"Of course you can, please do!","question":"Can Coverr Videos be used for commercial projects?"},{"answer":"Yes, we do! Check out our \u003Ca href=\"/developers\" aria-label=\"Developers page\" class=\"acu-link\">API documentation\u003C/a> for more details.","question":"Do you have an API?"}],"more_title":"Still have questions?","more_button":"See more questions about our free videos"},"meta":{"title":"Free Stock Video Footage, Royalty Free Videos for Download","description":"Download royalty free (for personal and commercial use), unique and beautiful video footage for your website or any project. No attribution required."},"plus":{"billed":{"yearly":"per month, billed yearly","monthly":"per month, billed monthly"},"titleHTML":"Get Exclusive Perks and Boost Your Creativity with \u003Cspan class=\"color-gradient-blue\">Coverr+ Premium Content\u003C/span>","description":"Upgrade to Coverr+ and enjoy members-only content, higher quality files and more..."},"music":{"text":"Never worry about rights and royalty","moods":{"title":"Mood","1_card_title":"Uplifting","2_card_title":"Dreamy","3_card_title":"Peaceful"},"genres":{"title":"Genres","1_card_title":"Hip Hop","2_card_title":"Cinematic","3_card_title":"Electronic"},"titleHTML":"Try \u003Cspan class=\"color-gradient-cyan\">Coverr music\u003C/span>","instruments":{"title":"Inst