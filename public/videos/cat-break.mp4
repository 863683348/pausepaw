to e modifica dei contenuti multimodali del settore"},"nl":{"description":"Seedance 2.0 leidt tot de meest uitgebreide multimodale contentreferentie- en bewerkingsmogelijkheden in de industrie"},"pt":{"description":"Seedance 2.0 leva à referência e edição de conteúdo multimodal mais abrangentes da indústria"}}},"video":null,"presets":[]}],"total":36,"page":0,"pageSize":100,"pages":1,"nbHits":36,"nbPages":1,"hitsPerPage":100},"h":{},"s":200,"st":"OK","u":"https://public-api.coverr.co/ai-video-apps","rt":"json"},"3962609031":{"b":{"id":"EfcaQATgnjT0","createdAt":"2026-06-17T22:42:05.907Z","updatedAt":"2026-06-17T22:49:31.636Z","name":"Trending Tags","key":"home_trending_tags","data":{"tags":[{"url":"/stock-video-footage/shopping","name":"shopping"},{"url":"/stock-video-footage/nature","name":"nature"},{"url":"/stock-video-footage/love","name":"love"},{"url":"/stock-video-footage/business","name":"business"},{"url":"/stock-video-footage/yoga","name":"yoga"}]},"translatedSlugs":[]},"h":{},"s":200,"st":"OK","u":"https://public-api.coverr.co/web-components/home_trending_tags","rt":"json"},"4046002681":{"b":{"hits":[{"id":"WlW0CDKxXtrm","createdAt":"2025-11-25T11:29:15.037Z","updatedAt":"2026-06-03T11:02:38.652Z","key":"free_monthly","name":"Free","description":"Basic access with limited features","price":"0.00","order":0,"effectivePrice":"0.00","discountPercent":0,"monthlyCredits":1000,"paddleProductPriceId":"temporary_WlW0CDKxXtrm","pricingVersion":"paddle_billing_v2","tier":"free","yearlyDiscount":16,"billingPeriod":"monthly","parallelTasks":{"video":{"value":1,"accumulativeEntitiesToCheck":["video","image"]}},"pricingOverrides":null,"featuresAllowlist":{"data":["generators.video","generators.image"]},"valueProposition":{"data":[{"name":"Basic video tools","badges":[],"tooltip":"Limited to SD quality"},{"name":"AI voiceover","badges":[],"tooltip":"Standard voices only"}]},"cardConfig":{"badge":"","state":"default","ctaCopy":"Sign Up","ctaColor":"inherit-white"}},{"id":"